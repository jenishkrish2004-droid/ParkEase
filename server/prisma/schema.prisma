generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PartnershipStatus {
  PARTNERSHIP_PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum KycStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PayoutMethod {
  BANK
  UPI
}

enum PayoutStatus {
  NOT_CONFIGURED
  CONFIGURED
  VERIFIED
  REJECTED
}

enum SelfieStatus {
  NOT_SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum VehicleTypeEnum {
  CAR
  BIKE
  EV
}
